# Public site URL (used for canonical links, OG tags and sitemap)
VITE_SITE_URL=https://aniketkumarray.vercel.app

# Contact form endpoint.
# Google Sheets via Apps Script — see docs/contact-form-google-sheet.md:
#   VITE_FORM_ENDPOINT=https://script.google.com/macros/s/<deployment-id>/exec
# Formspree: https://formspree.io/f/<your-form-id>
# Leave empty to fall back to a pre-filled mailto: link.
VITE_FORM_ENDPOINT=

# Plausible analytics domain (leave empty to disable analytics)
VITE_PLAUSIBLE_DOMAIN=
